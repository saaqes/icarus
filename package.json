{
  "name": "icarus",
  "version": "1.0.0",
  "private": true,
  "description": "ICARUS — herramientas digitales + forja de páginas web. TypeScript, sitio estático seguro.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist-server/index.js",
    "preview": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test.mjs --e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
